APP_NAME=JobSeeker Intelligence
APP_ENV=local
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://jobseeker:jobseeker_local@localhost:5432/jobseeker
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=data/uploads
CORS_ORIGINS=http://localhost:3000

AI_DEFAULT_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_MONTHLY_BUDGET_USD=20
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

GMAIL_ENABLED=false
GMAIL_CLIENT_SECRET_FILE=
GMAIL_TOKEN_FILE=
GMAIL_READ_ONLY=true
JOB_DISCOVERY_ENABLED=false
AUTO_EMAIL_SEND=false
AUTO_APPLICATION_SUBMIT=false
GLOBAL_AUTOMATION_PAUSED=true
