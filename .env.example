APP_ENV=local
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://jobseeker:jobseeker_local@localhost:5432/jobseeker
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=data/uploads
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

AI_DEFAULT_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

GMAIL_ENABLED=false
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
GMAIL_CLIENT_SECRET_FILE=/run/secrets/google-oauth-client.json

JOB_DISCOVERY_ENABLED=false
AUTO_EMAIL_SEND=false
AUTO_APPLICATION_SUBMIT=false
GLOBAL_AUTOMATION_PAUSED=true

# Set true only for a deliberate, audited operator role change.
ADMIN_BOOTSTRAP_ENABLED=false

# Optional event stream and private S3-compatible storage
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=jobseeker-api
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=jobseeker
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
